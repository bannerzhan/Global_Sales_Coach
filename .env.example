# 复制为 .env 并填入真实值
# ---- 火山方舟（控制台: console.volcengine.com/ark）----
ARK_API_KEY=ark-your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_ENDPOINT_PRO=ep-xxxx-pro
ARK_ENDPOINT_TURBO=ep-xxxx-turbo
ARK_MODEL_PRO=doubao-seed-2.1-pro-260628
ARK_MODEL_TURBO=doubao-seed-2.1-turbo-260628

# ---- 数据库（本地开发默认即可；部署时 deploy.sh 会生成随机密码）----
POSTGRES_PASSWORD=gsc_dev_password
DATABASE_URL=postgresql://gsc:gsc_dev_password@localhost:5433/gsc

# ---- 登录（单用户）----
# AUTH_SECRET 生成: openssl rand -base64 32
AUTH_SECRET=change-me-random-32-bytes
AUTH_USER_EMAIL=you@example.com
# 密码 hash 生成（部署脚本同款）:
#   docker run --rm httpd:2-alpine htpasswd -bnBC 10 "" '你的密码' | tr -d ':\n'
AUTH_USER_PASSWORD_HASH=$2y$10$xxxxx

NODE_ENV=development
